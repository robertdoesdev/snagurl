# Worker settings. Set these in the host's environment, not in a committed file.

# Required. 32 or more random characters, identical to the web app's
# SNAGURL_WORKER_SECRET.
SNAGURL_WORKER_SECRET=

# Listening address. Hosts such as Fly.io and Railway set PORT for you.
PORT=8080
HOST=0.0.0.0

# Scratch space for jobs. Should be a local disk with room for several
# in-flight files (see WORKER_MAX_CONCURRENT and the size limits).
WORKER_TMP_DIR=/tmp/snagurl-worker

# ffmpeg and ffprobe binaries. Defaults assume they are on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_FFMPEG_THREADS=2

# Capacity and limits. Defaults shown.
WORKER_MAX_CONCURRENT=2
WORKER_MAX_QUEUED=20
WORKER_JOB_TIMEOUT_SECONDS=600
WORKER_FETCH_IDLE_TIMEOUT_SECONDS=20
WORKER_FETCH_RETRIES=2
WORKER_MAX_INPUT_BYTES=500000000
WORKER_MAX_OUTPUT_BYTES=500000000
WORKER_MAX_DURATION_SECONDS=3600

# How long a finished file stays downloadable.
WORKER_RETENTION_MINUTES=30
