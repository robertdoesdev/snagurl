# ---------------------------------------------------------------------------
# Web app (Vercel). Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical links, sitemap, robots and social cards.
NEXT_PUBLIC_SITE_URL=https://snagurl.example

# Shown as a Contact link in the footer and on the legal pages when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Required in production. 32 or more random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SNAGURL_SIGNING_SECRET=

# Largest file a direct download may be, in bytes. Default is 250000000.
SNAGURL_MAX_FILE_BYTES=250000000

# Shared rate limiting across server instances. Both values come from an
# Upstash Redis database (REST API). Leave empty to use per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Conversion worker (optional). Conversion stays hidden until all of
# SNAGURL_WORKER_URL and SNAGURL_WORKER_SECRET are set and valid.
# ---------------------------------------------------------------------------

# Base URL of the deployed worker. Must be https in production. For local
# development http://localhost:8080 is accepted.
SNAGURL_WORKER_URL=

# Shared secret, 32 or more random characters. Must equal the worker's
# SNAGURL_WORKER_SECRET. Generate it the same way as the signing secret.
SNAGURL_WORKER_SECRET=

# Address the browser uses to download converted files. Leave empty to use
# SNAGURL_WORKER_URL. Set it when the worker is reached through a different
# public hostname than the one the web app calls.
SNAGURL_WORKER_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Platform APIs and licensed providers
# ---------------------------------------------------------------------------
# None. No YouTube, TikTok, X, Meta or Pinterest credentials are read by this
# release, because none of those APIs permits SnagUrl's use case (see README,
# Provider support). Do not add keys for them here.
